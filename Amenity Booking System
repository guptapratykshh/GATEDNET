<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Amenity Booking System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .booking-calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 8px;
        }
        .calendar-day {
            border-radius: 8px;
            padding: 8px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .calendar-day:hover {
            background-color: #e2e8f0;
        }
        .calendar-day.selected {
            background-color: #4f46e5;
            color: white;
        }
        .calendar-day.booked {
            background-color: #fecaca;
            color: #b91c1c;
            cursor: not-allowed;
        }
        .calendar-day.today {
            border: 2px solid #4f46e5;
        }
        .time-slot {
            padding: 8px 12px;
            border-radius: 6px;
            margin: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 1px solid #e2e8f0;
        }
        .time-slot:hover {
            background-color: #e2e8f0;
        }
        .time-slot.selected {
            background-color: #4f46e5;
            color: white;
            border-color: #4f46e5;
        }
        .time-slot.booked {
            background-color: #fecaca;
            color: #b91c1c;
            border-color: #fecaca;
            cursor: not-allowed;
        }
        .amenity-card {
            transition: all 0.2s ease;
            border-radius: 12px;
            overflow: hidden;
        }
        .amenity-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        .booking-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .booking-modal.active {
            opacity: 1;
            pointer-events: all;
        }
        .modal-content {
            background-color: white;
            border-radius: 12px;
            max-width: 500px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            transform: translateY(20px);
            transition: transform 0.3s ease;
        }
        .booking-modal.active .modal-content {
            transform: translateY(0);
        }
        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            background-color: #f00;
            opacity: 0;
            z-index: 1001;
            animation: confetti-fall 3s ease-in-out;
        }
        @keyframes confetti-fall {
            0% {
                transform: translateY(-100vh) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(100vh) rotate(360deg);
                opacity: 0;
            }
        }
        .loading-spinner {
            border: 4px solid rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            border-top: 4px solid #4f46e5;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-gray-50">
    <div class="container mx-auto px-4 py-8">
        <header class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-800">Amenity Booking System</h1>
            <p class="text-gray-600">Book shared facilities in real-time</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <!-- Filter Section -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-semibold mb-4">Filters</h2>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Amenity Type</label>
                    <select id="amenityTypeFilter" class="w-full border border-gray-300 rounded-md p-2">
                        <option value="all">All Amenities</option>
                        <option value="meeting-room">Meeting Rooms</option>
                        <option value="gym">Gym Facilities</option>
                        <option value="pool">Swimming Pool</option>
                        <option value="bbq">BBQ Pits</option>
                        <option value="tennis">Tennis Courts</option>
                    </select>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Date</label>
                    <input type="date" id="dateFilter" class="w-full border border-gray-300 rounded-md p-2">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Time Slot</label>
                    <select id="timeSlotFilter" class="w-full border border-gray-300 rounded-md p-2">
                        <option value="all">All Times</option>
                        <option value="morning">Morning (8AM-12PM)</option>
                        <option value="afternoon">Afternoon (12PM-5PM)</option>
                        <option value="evening">Evening (5PM-10PM)</option>
                    </select>
                </div>
            </div>

            <!-- Calendar Section -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-semibold mb-4">Availability Calendar</h2>
                <div class="flex justify-between items-center mb-4">
                    <button id="prevMonth" class="text-gray-500 hover:text-gray-700">&lt; Previous</button>
                    <h3 id="currentMonth" class="font-medium">June 2023</h3>
                    <button id="nextMonth" class="text-gray-500 hover:text-gray-700">Next &gt;</button>
                </div>
                <div class="booking-calendar mb-4">
                    <div class="text-sm font-medium text-gray-500 py-1">Sun</div>
                    <div class="text-sm font-medium text-gray-500 py-1">Mon</div>
                    <div class="text-sm font-medium text-gray-500 py-1">Tue</div>
                    <div class="text-sm font-medium text-gray-500 py-1">Wed</div>
                    <div class="text-sm font-medium text-gray-500 py-1">Thu</div>
                    <div class="text-sm font-medium text-gray-500 py-1">Fri</div>
                    <div class="text-sm font-medium text-gray-500 py-1">Sat</div>
                    <!-- Days will be populated by JavaScript -->
                </div>
                <div id="timeSlots" class="grid grid-cols-3 gap-2">
                    <!-- Time slots will be populated by JavaScript -->
                </div>
            </div>

            <!-- Booking Summary -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-semibold mb-4">Your Booking</h2>
                <div id="bookingSummary" class="mb-4 p-4 bg-gray-50 rounded-lg">
                    <p class="text-gray-500">No booking selected</p>
                </div>
                <button id="confirmBookingBtn" class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed" disabled>
                    Confirm Booking
                </button>
                <div id="upcomingBookings" class="mt-6">
                    <h3 class="font-medium mb-2">Your Upcoming Bookings</h3>
                    <div id="bookingsList" class="space-y-2">
                        <!-- Bookings will be populated by JavaScript -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Amenities Grid -->
        <div class="mb-8">
            <h2 class="text-2xl font-semibold mb-4">Available Amenities</h2>
            <div id="amenitiesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Amenity cards will be populated by JavaScript -->
            </div>
        </div>
    </div>

    <!-- Booking Modal -->
    <div id="bookingModal" class="booking-modal">
        <div class="modal-content">
            <div class="p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold">Confirm Booking</h2>
                    <button id="closeModal" class="text-gray-500 hover:text-gray-700">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <div id="modalContent">
                    <!-- Modal content will be populated by JavaScript -->
                </div>
                <div class="mt-6 flex justify-end space-x-3">
                    <button id="cancelBookingBtn" class="px-4 py-2 border border-gray-300 rounded-md hover:bg-gray-50">
                        Cancel
                    </button>
                    <button id="finalConfirmBtn" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
                        Confirm Booking
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div id="confirmationModal" class="booking-modal">
        <div class="modal-content">
            <div class="p-6 text-center">
                <div class="mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                </div>
                <h2 class="text-xl font-semibold mb-2">Booking Confirmed!</h2>
                <p id="confirmationDetails" class="text-gray-600 mb-6"></p>
                <button id="closeConfirmationModal" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
                    Done
                </button>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // DOM Elements
            const amenitiesGrid = document.getElementById('amenitiesGrid');
            const bookingCalendar = document.querySelector('.booking-calendar');
            const timeSlotsContainer = document.getElementById('timeSlots');
            const bookingSummary = document.getElementById('bookingSummary');
            const confirmBookingBtn = document.getElementById('confirmBookingBtn');
            const bookingsList = document.getElementById('bookingsList');
            const bookingModal = document.getElementById('bookingModal');
            const modalContent = document.getElementById('modalContent');
            const closeModal = document.getElementById('closeModal');
            const cancelBookingBtn = document.getElementById('cancelBookingBtn');
            const finalConfirmBtn = document.getElementById('finalConfirmBtn');
            const confirmationModal = document.getElementById('confirmationModal');
            const confirmationDetails = document.getElementById('confirmationDetails');
            const closeConfirmationModal = document.getElementById('closeConfirmationModal');
            const currentMonthElement = document.getElementById('currentMonth');
            const prevMonthBtn = document.getElementById('prevMonth');
            const nextMonthBtn = document.getElementById('nextMonth');
            const amenityTypeFilter = document.getElementById('amenityTypeFilter');
            const dateFilter = document.getElementById('dateFilter');
            const timeSlotFilter = document.getElementById('timeSlotFilter');

            // State
            let selectedAmenity = null;
            let selectedDate = null;
            let selectedTimeSlot = null;
            let currentMonth = new Date().getMonth();
            let currentYear = new Date().getFullYear();
            let bookings = JSON.parse(localStorage.getItem('bookings')) || [];
            let amenities = [
                {
                    id: 'meeting-room-1',
                    name: 'Meeting Room A',
                    type: 'meeting-room',
                    capacity: '8 people',
                    description: 'Conference room with projector and whiteboard',
                    image: 'https://placehold.co/600x400?text=Meeting+Room+A',
                    availableSlots: ['09:00-10:00', '10:00-11:00', '14:00-15:00', '15:00-16:00']
                },
                {
                    id: 'meeting-room-2',
                    name: 'Meeting Room B',
                    type: 'meeting-room',
                    capacity: '12 people',
                    description: 'Large conference room with video conferencing',
                    image: 'https://placehold.co/600x400?text=Meeting+Room+B',
                    availableSlots: ['10:00-11:00', '11:00-12:00', '16:00-17:00']
                },
                {
                    id: 'gym-facility',
                    name: 'Gym Facility',
                    type: 'gym',
                    capacity: '20 people',
                    description: 'Fully equipped gym with cardio and weight training',
                    image: 'https://placehold.co/600x400?text=Gym+Facility',
                    availableSlots: ['06:00-07:00', '07:00-08:00', '18:00-19:00', '19:00-20:00']
                },
                {
                    id: 'swimming-pool',
                    name: 'Swimming Pool',
                    type: 'pool',
                    capacity: '15 people',
                    description: '25m swimming pool with lap lanes',
                    image: 'https://placehold.co/600x400?text=Swimming+Pool',
                    availableSlots: ['07:00-09:00', '16:00-18:00', '19:00-21:00']
                },
                {
                    id: 'bbq-pit-1',
                    name: 'BBQ Pit 1',
                    type: 'bbq',
                    capacity: '10 people',
                    description: 'Outdoor BBQ pit with seating area',
                    image: 'https://placehold.co/600x400?text=BBQ+Pit+1',
                    availableSlots: ['17:00-19:00', '19:00-21:00']
                },
                {
                    id: 'tennis-court',
                    name: 'Tennis Court',
                    type: 'tennis',
                    capacity: '4 people',
                    description: 'Full-size tennis court with lighting',
                    image: 'https://placehold.co/600x400?text=Tennis+Court',
                    availableSlots: ['08:00-10:00', '10:00-12:00', '16:00-18:00', '18:00-20:00']
                }
            ];

            // Initialize the app
            function initApp() {
                renderAmenities();
                renderCalendar();
                renderTimeSlots();
                renderBookings();
                setTodayAsDefault();
                setupEventListeners();
            }

            // Render amenities grid
            function renderAmenities(filterType = 'all') {
                amenitiesGrid.innerHTML = '';
                
                const filteredAmenities = filterType === 'all' 
                    ? amenities 
                    : amenities.filter(amenity => amenity.type === filterType);
                
                filteredAmenities.forEach(amenity => {
                    const amenityCard = document.createElement('div');
                    amenityCard.className = 'amenity-card bg-white rounded-lg shadow-md overflow-hidden';
                    amenityCard.innerHTML = `
                        <img src="${amenity.image}" alt="${amenity.name}" class="w-full h-48 object-cover">
                        <div class="p-4">
                            <h3 class="font-semibold text-lg mb-1">${amenity.name}</h3>
                            <p class="text-sm text-gray-500 mb-2">${amenity.capacity}</p>
                            <p class="text-sm text-gray-600 mb-3">${amenity.description}</p>
                            <button class="book-btn w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700" data-amenity-id="${amenity.id}">
                                Book Now
                            </button>
                        </div>
                    `;
                    amenitiesGrid.appendChild(amenityCard);
                });
            }

            // Render calendar
            function renderCalendar() {
                // Clear existing calendar days
                while (bookingCalendar.children.length > 7) {
                    bookingCalendar.removeChild(bookingCalendar.lastChild);
                }
                
                // Set current month text
                const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                currentMonthElement.textContent = `${monthNames[currentMonth]} ${currentYear}`;
                
                // Get first day of month and total days
                const firstDay = new Date(currentYear, currentMonth, 1).getDay();
                const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
                const today = new Date();
                
                // Add empty cells for days before the first day of the month
                for (let i = 0; i < firstDay; i++) {
                    const emptyDay = document.createElement('div');
                    bookingCalendar.appendChild(emptyDay);
                }
                
                // Add days of the month
                for (let day = 1; day <= daysInMonth; day++) {
                    const dayElement = document.createElement('div');
                    dayElement.className = 'calendar-day';
                    dayElement.textContent = day;
                    
                    const date = new Date(currentYear, currentMonth, day);
                    dayElement.dataset.date = date.toISOString().split('T')[0];
                    
                    // Highlight today
                    if (date.toDateString() === today.toDateString()) {
                        dayElement.classList.add('today');
                    }
                    
                    // Mark booked dates
                    const bookedDates = getBookedDatesForSelectedAmenity();
                    if (bookedDates.includes(dayElement.dataset.date)) {
                        dayElement.classList.add('booked');
                    }
                    
                    // Highlight selected date
                    if (selectedDate === dayElement.dataset.date) {
                        dayElement.classList.add('selected');
                    }
                    
                    dayElement.addEventListener('click', function() {
                        if (!this.classList.contains('booked')) {
                            document.querySelectorAll('.calendar-day').forEach(day => {
                                day.classList.remove('selected');
                            });
                            this.classList.add('selected');
                            selectedDate = this.dataset.date;
                            renderTimeSlots();
                            updateBookingSummary();
                        }
                    });
                    
                    bookingCalendar.appendChild(dayElement);
                }
            }

            // Render time slots
            function renderTimeSlots() {
                timeSlotsContainer.innerHTML = '';
                
                if (!selectedAmenity || !selectedDate) {
                    timeSlotsContainer.innerHTML = '<p class="text-gray-500 col-span-3 text-center py-4">Select an amenity and date to see available time slots</p>';
                    return;
                }
                
                const amenity = amenities.find(a => a.id === selectedAmenity);
                const bookedSlots = getBookedSlotsForSelectedAmenityAndDate();
                
                amenity.availableSlots.forEach(slot => {
                    const slotElement = document.createElement('div');
                    slotElement.className = 'time-slot';
                    slotElement.textContent = slot;
                    slotElement.dataset.slot = slot;
                    
                    if (bookedSlots.includes(slot)) {
                        slotElement.classList.add('booked');
                    } else if (selectedTimeSlot === slot) {
                        slotElement.classList.add('selected');
                    }
                    
                    slotElement.addEventListener('click', function() {
                        if (!this.classList.contains('booked')) {
                            document.querySelectorAll('.time-slot').forEach(slot => {
                                slot.classList.remove('selected');
                            });
                            this.classList.add('selected');
                            selectedTimeSlot = this.dataset.slot;
                            updateBookingSummary();
                        }
                    });
                    
                    timeSlotsContainer.appendChild(slotElement);
                });
            }

            // Render user bookings
            function renderBookings() {
                bookingsList.innerHTML = '';
                
                if (bookings.length === 0) {
                    bookingsList.innerHTML = '<p class="text-gray-500">No upcoming bookings</p>';
                    return;
                }
                
                // Sort bookings by date
                const sortedBookings = [...bookings].sort((a, b) => new Date(a.date) - new Date(b.date));
                
                sortedBookings.forEach(booking => {
                    const bookingElement = document.createElement('div');
                    bookingElement.className = 'bg-gray-50 p-3 rounded-lg';
                    bookingElement.innerHTML = `
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-medium">${getAmenityNameById(booking.amenityId)}</h4>
                                <p class="text-sm text-gray-600">${formatDate(booking.date)} at ${booking.timeSlot}</p>
                            </div>
                            <button class="cancel-booking text-red-500 text-sm" data-booking-id="${booking.id}">
                                Cancel
                            </button>
                        </div>
                    `;
                    bookingsList.appendChild(bookingElement);
                });
            }

            // Update booking summary
            function updateBookingSummary() {
                if (selectedAmenity && selectedDate && selectedTimeSlot) {
                    const amenity = amenities.find(a => a.id === selectedAmenity);
                    bookingSummary.innerHTML = `
                        <h4 class="font-medium mb-2">${amenity.name}</h4>
                        <p class="text-sm text-gray-600 mb-1">${formatDate(selectedDate)}</p>
                        <p class="text-sm text-gray-600 mb-1">${selectedTimeSlot}</p>
                        <p class="text-sm text-gray-600">${amenity.capacity}</p>
                    `;
                    confirmBookingBtn.disabled = false;
                } else {
                    bookingSummary.innerHTML = '<p class="text-gray-500">No booking selected</p>';
                    confirmBookingBtn.disabled = true;
                }
            }

            // Show booking modal
            function showBookingModal() {
                if (selectedAmenity && selectedDate && selectedTimeSlot) {
                    const amenity = amenities.find(a => a.id === selectedAmenity);
                    modalContent.innerHTML = `
                        <div class="mb-4">
                            <h3 class="font-medium text-lg">${amenity.name}</h3>
                            <p class="text-gray-600">${amenity.description}</p>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div>
                                <p class="text-sm text-gray-500">Date</p>
                                <p class="font-medium">${formatDate(selectedDate)}</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500">Time Slot</p>
                                <p class="font-medium">${selectedTimeSlot}</p>
                            </div>
                            <div>
                                <p class="text-sm text-gray-500">Capacity</p>
                                <p class="font-medium">${amenity.capacity}</p>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-gray-700 mb-1">Additional Notes (Optional)</label>
                            <textarea id="bookingNotes" class="w-full border border-gray-300 rounded-md p-2" rows="3" placeholder="Any special requests..."></textarea>
                        </div>
                    `;
                    bookingModal.classList.add('active');
                }
            }

            // Confirm booking
            function confirmBooking() {
                const notes = document.getElementById('bookingNotes').value;
                const bookingId = 'booking-' + Date.now();
                
                const newBooking = {
                    id: bookingId,
                    amenityId: selectedAmenity,
                    amenityName: getAmenityNameById(selectedAmenity),
                    date: selectedDate,
                    timeSlot: selectedTimeSlot,
                    notes: notes,
                    createdAt: new Date().toISOString()
                };
                
                bookings.push(newBooking);
                localStorage.setItem('bookings', JSON.stringify(bookings));
                
                // Show confirmation
                bookingModal.classList.remove('active');
                showConfirmation(newBooking);
                
                // Reset selection
                resetSelection();
                
                // Update UI
                renderCalendar();
                renderTimeSlots();
                renderBookings();
                updateBookingSummary();
            }

            // Show confirmation
            function showConfirmation(booking) {
                confirmationDetails.textContent = `You have successfully booked ${booking.amenityName} on ${formatDate(booking.date)} at ${booking.timeSlot}.`;
                confirmationModal.classList.add('active');
                createConfetti();
            }

            // Cancel booking
            function cancelBooking(bookingId) {
                bookings = bookings.filter(booking => booking.id !== bookingId);
                localStorage.setItem('bookings', JSON.stringify(bookings));
                renderBookings();
                renderCalendar();
                renderTimeSlots();
            }

            // Reset selection
            function resetSelection() {
                selectedAmenity = null;
                selectedDate = null;
                selectedTimeSlot = null;
                document.querySelectorAll('.calendar-day.selected, .time-slot.selected').forEach(el => {
                    el.classList.remove('selected');
                });
            }

            // Get booked dates for selected amenity
            function getBookedDatesForSelectedAmenity() {
                if (!selectedAmenity) return [];
                
                return bookings
                    .filter(booking => booking.amenityId === selectedAmenity)
                    .map(booking => booking.date);
            }

            // Get booked slots for selected amenity and date
            function getBookedSlotsForSelectedAmenityAndDate() {
                if (!selectedAmenity || !selectedDate) return [];
                
                return bookings
                    .filter(booking => booking.amenityId === selectedAmenity && booking.date === selectedDate)
                    .map(booking => booking.timeSlot);
            }

            // Get amenity name by ID
            function getAmenityNameById(amenityId) {
                const amenity = amenities.find(a => a.id === amenityId);
                return amenity ? amenity.name : '';
            }

            // Format date
            function formatDate(dateString) {
                const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
                return new Date(dateString).toLocaleDateString('en-US', options);
            }

            // Set today as default date
            function setTodayAsDefault() {
                const today = new Date();
                dateFilter.valueAsDate = today;
                
                // Find today in calendar and select it
                const todayString = today.toISOString().split('T')[0];
                const todayElement = document.querySelector(`.calendar-day[data-date="${todayString}"]`);
                if (todayElement && !todayElement.classList.contains('booked')) {
                    todayElement.click();
                }
            }

            // Create confetti effect
            function createConfetti() {
                const colors = ['#4f46e5', '#10b981', '#f59e0b', '#ef4444', '#8b5cf6'];
                
                for (let i = 0; i < 50; i++) {
                    const confetti = document.createElement('div');
                    confetti.className = 'confetti';
                    confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                    confetti.style.left = Math.random() * 100 + 'vw';
                    confetti.style.animationDuration = (Math.random() * 3 + 2) + 's';
                    confetti.style.width = (Math.random() * 10 + 5) + 'px';
                    confetti.style.height = (Math.random() * 10 + 5) + 'px';
                    document.body.appendChild(confetti);
                    
                    setTimeout(() => {
                        confetti.remove();
                    }, 3000);
                }
            }

            // Setup event listeners
            function setupEventListeners() {
                // Book amenity buttons
                amenitiesGrid.addEventListener('click', function(e) {
                    if (e.target.classList.contains('book-btn')) {
                        selectedAmenity = e.target.dataset.amenityId;
                        renderTimeSlots();
                        updateBookingSummary();
                        
                        // Scroll to calendar
                        document.querySelector('.booking-calendar').scrollIntoView({ behavior: 'smooth' });
                    }
                });
                
                // Confirm booking button
                confirmBookingBtn.addEventListener('click', showBookingModal);
                
                // Modal buttons
                closeModal.addEventListener('click', () => bookingModal.classList.remove('active'));
                cancelBookingBtn.addEventListener('click', () => bookingModal.classList.remove('active'));
                finalConfirmBtn.addEventListener('click', confirmBooking);
                
                // Confirmation modal
                closeConfirmationModal.addEventListener('click', () => confirmationModal.classList.remove('active'));
                
                // Calendar navigation
                prevMonthBtn.addEventListener('click', function() {
                    currentMonth--;
                    if (currentMonth < 0) {
                        currentMonth = 11;
                        currentYear--;
                    }
                    renderCalendar();
                });
                
                nextMonthBtn.addEventListener('click', function() {
                    currentMonth++;
                    if (currentMonth > 11) {
                        currentMonth = 0;
                        currentYear++;
                    }
                    renderCalendar();
                });
                
                // Cancel booking buttons
                bookingsList.addEventListener('click', function(e) {
                    if (e.target.classList.contains('cancel-booking')) {
                        if (confirm('Are you sure you want to cancel this booking?')) {
                            cancelBooking(e.target.dataset.bookingId);
                        }
                    }
                });
                
                // Filters
                amenityTypeFilter.addEventListener('change', function() {
                    renderAmenities(this.value);
                });
                
                dateFilter.addEventListener('change', function() {
                    const selectedDate = new Date(this.value);
                    currentMonth = selectedDate.getMonth();
                    currentYear = selectedDate.getFullYear();
                    renderCalendar();
                    
                    // Find and select the date in calendar
                    const dateString = this.value;
                    const dateElement = document.querySelector(`.calendar-day[data-date="${dateString}"]`);
                    if (dateElement && !dateElement.classList.contains('booked')) {
                        dateElement.click();
                    }
                });
                
                timeSlotFilter.addEventListener('change', function() {
                    // This would filter the amenities by available time slots in a real app
                    // For this demo, we'll just show a message
                    if (this.value !== 'all') {
                        alert('Filtering by time slot would show only amenities available during ' + this.value + ' in a real application.');
                    }
                });
            }

            // Initialize the app
            initApp();
        });
    </script>
</body>
</html>
